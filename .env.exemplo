# Modelo de configuração do atende+.
# Para usar: copie este arquivo com o nome .env e ajuste os valores.
# Sem .env, o projeto roda em modo de desenvolvimento (bom para testar na sua máquina).
# O .env NUNCA vai para o GitHub (está no .gitignore).

# Modo de depuração: True na sua máquina, False no servidor de publicação.
DEBUG=True

# Chave secreta do Django. No servidor, gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-esta-chave

# Endereços em que o site responde, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# No servidor HTTPS, o endereço completo do site (ex.: https://natcurti.pythonanywhere.com).
CSRF_TRUSTED_ORIGINS=

# Nome do arquivo do banco SQLite, dentro da pasta do projeto.
SQLITE_ARQUIVO=db.sqlite3
